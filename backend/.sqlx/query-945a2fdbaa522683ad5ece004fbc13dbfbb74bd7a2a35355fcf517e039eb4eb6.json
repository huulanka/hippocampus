  "query": "\n        select cs.event_id, cs.transcript, cs.occurred_at\n        from capture_search cs\n        where cs.occurred_at < $2\n          and cs.occurred_at >= $3\n          and cs.event_id <> $1\n        order by cs.occurred_at desc\n        limit $4\n        ",
