{
  "db_name": "PostgreSQL",
  "query": "\n        select o.source_event_id, o.text as observation,\n               cs.transcript, cs.occurred_at\n        from observations o\n        join capture_search cs on cs.event_id = o.source_event_id\n        where o.entity_id = $1\n        order by cs.occurred_at desc\n        limit $2\n        ",
