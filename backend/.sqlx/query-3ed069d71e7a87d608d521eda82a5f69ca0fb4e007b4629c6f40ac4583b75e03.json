  "db_name": "PostgreSQL",
  "query": "\n        select distinct\n            o.source_event_id,\n            e.id,\n            e.entity_type,\n            e.name,\n            e.current_summary\n        from observations o\n        join entities e on e.id = o.entity_id\n        where o.source_event_id = any($1)\n        order by e.name\n        ",
