  "query": "\n        select e.occurred_at, e.payload, cc.redacted_at as \"redacted_at?\"\n        from events e\n        left join capture_content cc on cc.event_id = e.id\n        where e.id = $1 and e.event_type = 'capture.recorded'\n        ",
