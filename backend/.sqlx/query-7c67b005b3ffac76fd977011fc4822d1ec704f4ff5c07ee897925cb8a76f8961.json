{
  "db_name": "PostgreSQL",
  "query": "\n        select e.echo_event_id, e.score, e.similarity, s.transcript, s.occurred_at\n        from capture_echo e\n        join capture_search s on s.event_id = e.echo_event_id\n        where e.capture_event_id = $1 and e.score >= $2\n        order by e.rank\n        limit $3\n        ",
