{
  "db_name": "PostgreSQL",
  "query": "\n        with scored as (\n            select\n                event_id,\n                transcript,\n                occurred_at,\n                (\n                    (1 - (embedding <=> $1)) * 0.7\n                    + coalesce(ts_rank(tsv, plainto_tsquery('german', $2)), 0.0) * 0.3\n                ) as score\n            from capture_search\n            where embedding is not null\n        )\n        select event_id, transcript, occurred_at, score as \"score!\"\n        from scored\n        order by score desc\n        limit $3\n        ",
