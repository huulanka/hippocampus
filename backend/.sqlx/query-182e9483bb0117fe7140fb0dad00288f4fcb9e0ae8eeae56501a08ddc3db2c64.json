  "db_name": "PostgreSQL",
  "query": "\n        select\n            e.occurred_at,\n            e.payload,\n            cc.origin as \"origin?\",\n            cc.text as \"text?\",\n            cc.audio_mime as \"audio_mime?\",\n            cc.duration_ms as \"duration_ms?\",\n            cc.redacted_at as \"redacted_at?\"\n        from events e\n        left join capture_content cc on cc.event_id = e.id\n        where e.id = $1 and e.event_type = 'capture.recorded'\n        ",
