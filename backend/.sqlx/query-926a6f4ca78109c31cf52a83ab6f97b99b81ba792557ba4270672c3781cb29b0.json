{
  "db_name": "PostgreSQL",
  "query": "\n        select en.id, en.entity_type, en.name, o.text as observation, o.model, o.confidence\n        from observations o\n        join entities en on en.id = o.entity_id\n        where o.source_event_id = $1\n        order by o.created_at\n        ",
