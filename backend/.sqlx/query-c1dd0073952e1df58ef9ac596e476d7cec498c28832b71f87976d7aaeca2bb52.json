{
  "db_name": "PostgreSQL",
  "query": "\n        select cs.event_id, cs.occurred_at\n        from capture_search cs\n        where not exists (\n            select 1 from capture_occasion_checked c\n            where c.capture_event_id = cs.event_id and c.checker = $1\n        )\n        order by cs.occurred_at desc\n        limit $2\n        ",
