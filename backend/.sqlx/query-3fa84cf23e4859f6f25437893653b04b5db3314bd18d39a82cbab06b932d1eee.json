{
  "db_name": "PostgreSQL",
  "query": "\n        select\n            r.from_entity_id as \"from!\",\n            r.to_entity_id as \"to!\",\n            r.relation_type,\n            count(*) as \"weight!\"\n        from relations r\n        where r.from_entity_id = any($1) and r.to_entity_id = any($1)\n        group by r.from_entity_id, r.to_entity_id, r.relation_type\n        order by count(*) desc\n        ",
