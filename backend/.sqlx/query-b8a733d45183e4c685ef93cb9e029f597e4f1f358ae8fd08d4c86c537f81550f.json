{
  "db_name": "PostgreSQL",
  "query": "\n        select\n            event_id,\n            transcript,\n            occurred_at,\n            (1 - (embedding <=> $1))::real as \"similarity!\"\n        from capture_search\n        where embedding is not null\n          and occurred_at < $2\n          and ($3::uuid is null or event_id <> $3)\n          and (1 - (embedding <=> $1)) >= $4\n        order by embedding <=> $1\n        limit $5\n        ",
