  "query": "\n        select e.id, e.entity_type\n        from entities e\n        left join observations o on o.entity_id = e.id\n        where lower(e.name) = lower($1)\n        group by e.id, e.entity_type\n        order by count(o.id) desc\n        limit 1\n        ",
