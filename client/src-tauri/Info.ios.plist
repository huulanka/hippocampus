<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apps built with the iOS 27 SDK refuse to launch without the scene
	     life cycle. tao only adopts it when this manifest is present and
	     says multiple scenes are supported; an iPhone still shows one. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<!-- Without it iOS ends the app the moment it asks for the microphone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Hippocampus records what you say to keep it as a note. It is transcribed on this iPhone, and the recording is kept with the note on your own backend.</string>
</dict>
</plist>
