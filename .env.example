# Copy to .env and fill in. Never commit the real .env file.

# Postgres connection used by the backend.
DATABASE_URL=postgres://hippocampus:hippocampus@localhost:5433/hippocampus

# Address the backend HTTP server binds to.
BIND_ADDR=0.0.0.0:8080

# Where downloaded ONNX embedding model files are cached, so they survive
# restarts instead of re-downloading (~450MB) every time. Defaults to
# ../data/models (relative to backend/) for local `cargo run`.
MODEL_CACHE_DIR=

# OpenRouter API key used for structure extraction (entities/relations/tasks).
# Get one at https://openrouter.ai/keys — prefer a provider with a
# zero-data-retention policy given how personal the captured content is.
OPENROUTER_API_KEY=

# Which model does the structure extraction (entities/relations/tasks).
# Default google/gemini-3.5-flash-lite. Recorded as provenance on every
# observation it produces, so a change is visible in the data rather than
# only in the configuration.
OPENROUTER_MODEL=

# Route only to providers that keep no copy of what is sent. Default true;
# set to "false" to allow the rest. This is the one place capture text
# leaves the machine (twice: structuring, and echo judging when
# HIPPOCAMPUS_RERANKER=remote), so the default is the strict one.
OPENROUTER_ZDR=

# Expected "aud" claim of the Cloudflare Access JWT, once the backend is
# deployed behind the Cloudflare Tunnel + Zero Trust Access application.
# Leave empty for local development (JWT verification is skipped, and the
# backend says so loudly at startup).
CF_ACCESS_AUD=

# Zero Trust team, as a name ("acme") or a hostname
# ("acme.cloudflareaccess.com"). This is where the signing keys are
# fetched from. Required whenever CF_ACCESS_AUD is set — the backend
# refuses to start with one but not the other, because half-configured
# access control looks protected and is not.
CF_ACCESS_TEAM_DOMAIN=

# Comma-separated origins allowed to call this backend from a browser.
# Defaults to the desktop client: tauri://localhost,http://localhost:1420.
# A wildcard is rejected — this service answers with everything you have
# ever said, and any page in any tab would be able to read it.
CORS_ALLOWED_ORIGINS=

# Minimum cosine similarity (0-1) for an earlier capture to be shown as an
# echo. multilingual-e5-small compresses its range, so unrelated German
# sentences still score ~0.87 — below roughly 0.89 every capture echoes
# something. Tune against real captures; default 0.89.
ECHO_MIN_SIMILARITY=

# Who judges which echo candidates are real: remote, bge or off.
# Default remote — a small hosted model over the same OpenRouter path and
# the same ZDR routing the structuring step uses, which is the only option
# that is usable on NAS hardware (see below and ADR 0010).
#
# "bge" runs bge-reranker-v2-m3 locally: 2.1 GB of model, ~1.3-1.5s for
# ten candidates on an M-series Mac — and 9.4 seconds PER CANDIDATE on a
# Synology DS220+, measured. It is the only option that keeps capture text
# on the machine, so it is the right one on hardware that can afford it.
#
# "off" falls back to embedding similarity alone, which measurably ranks
# unrelated captures above related ones.
HIPPOCAMPUS_RERANKER=

# Which hosted model judges echoes when HIPPOCAMPUS_RERANKER=remote.
# Default mistralai/mistral-small-2603, chosen for German: these are
# German notes, and the one case this system is known to have got wrong
# turned on German nuance. Any OpenRouter model id works; it is recorded
# on each stored judgement as provenance, so switching is visible rather
# than silent. Around 1000 input tokens once per capture, so cost is not
# the deciding variable between serious candidates.
ECHO_JUDGE_MODEL=

# How long a failed echo judgement blocks a new attempt for the same
# capture, in seconds. Default 20. A capture is judged on every read that
# finds no stored verdict yet, and the client polls every 1.2s while it
# waits — without this, one failing call (a provider rate limit, say)
# turns into a new paid call several times a second for as long as anyone
# is looking at the note.
ECHO_JUDGE_RETRY_BACKOFF_SECS=

# Minimum judge score for an echo to be shown. The scales are not
# comparable, so the default depends on who is judging: 0.5 for a remote
# judge (which is asked for a 0-1 relevance, so half is the meaningful
# midpoint — not yet calibrated against real captures), -4.0 for bge (raw
# logits, calibrated against one real capture so far; see
# reranker::default_min_score). Tune by calling
# GET /captures/{id}/echo?min_rerank=-99 and looking at the scores — every
# candidate is stored with its score, so this costs nothing to retune.
ECHO_MIN_RERANK_SCORE=

# Fallback timezone for resolving "tomorrow", "next Tuesday" and the like
# into real dates. Only used when a capture did not say where it was
# recorded — the desktop client sends its own. IANA name; default
# Europe/Berlin.
HIPPOCAMPUS_TIMEZONE=

# --- Finishing captures that did not finish the first time ---------------
#
# A capture is permanent the moment it is written to capture_content. Two
# things then still have to happen — embedding it for search, and having
# the model read it — and both talk to something that can be down. When
# either fails the capture stays on `capture_pipeline` and this loop comes
# back for it. Without that, a failed structuring call meant the note was
# there and its meaning was silently gone: no entities, no resolved date,
# never in Resurface, and nothing on screen saying so.
#
# Set to false to switch the loop off entirely. A capture whose
# structuring fails then stays unstructured until asked for by hand
# (POST /pipeline/retry, or the sidebar's "try now").
STRUCTURING_RETRY_ENABLED=

# How often the loop looks for unfinished captures, in seconds.
# Default 300. Minutes rather than seconds on purpose: this is catch-up
# work for a provider that was down, and asking every few seconds would
# only turn one outage into a lot of failed calls.
STRUCTURING_RETRY_INTERVAL_SECS=

# How long a capture waits after a failed attempt before the loop tries it
# again, in seconds. Default 900.
STRUCTURING_RETRY_BACKOFF_SECS=

# How many captures one pass may work through. Default 5. Bounded because
# every one of them is a paid call.
STRUCTURING_RETRY_BATCH=

# How many failures before the loop gives up on a capture and leaves it
# for a person. Default 5 — a fault that survives five attempts spread
# over more than an hour is not a blip. Given-up captures are counted by
# GET /pipeline and shown in the client's sidebar.
STRUCTURING_MAX_ATTEMPTS=

# --- Consolidating the graph ------------------------------------------
#
# A cyclic pass that tidies how knowledge is organised, never what was
# said. It folds together entries that are one thing under two names,
# unifies drifted type words, and draws edges between things that were
# never mentioned in one breath — which is the only way such an edge can
# exist at all, since a single extraction can only link what appeared in
# one sentence.
#
# Everything it does is an event: entity.merged, entity.renamed,
# entity.retyped, relation.proposed. GET /consolidation is the changelog,
# POST /entities/{id}/unmerge takes a merge back, DELETE /relations/{id}
# takes a derived edge back, and either one is never proposed again.
#
# Off by default, and that default is deliberate, not a placeholder: set
# this to exactly "true" only if a pass on a timer is actually wanted.
# Ordinarily this is manual — GET /consolidation/preview shows what a pass
# would do and stores it, and POST /consolidation/apply carries out
# whichever parts of that preview a person kept.
CONSOLIDATION_ENABLED=

# How often a pass runs, in seconds. Default 3600, and the first pass is
# one full interval after startup — deliberately unhurried. A duplicate
# surviving another hour costs nothing, and the pace is itself a safety
# property: a mistake has time to be noticed before it has spread.
CONSOLIDATION_INTERVAL_SECS=

# Where capture audio is stored. This is the archive of originals
# (docs/adr/0004): it must live on backed-up storage. Defaults to
# ../data/audio (relative to backend/) for local `cargo run`.
AUDIO_DIR=

# Where the backend writes its own log file (rolls daily, alongside
# whatever it prints to stdout/stderr). Defaults to ../data/logs
# (relative to backend/) for local `cargo run`.
LOG_DIR=

# docker-compose.yml only (not read by the backend binary itself): where
# Postgres, models, audio and logs are bind-mounted from on the host.
# Defaults to ./data, next to docker-compose.yml — fine for local
# `docker compose up`, but a Portainer "deploy from Git repository" stack
# clones the repo into its own managed directory, so point this at real
# NAS storage instead (e.g. /volume1/docker/hippocampus/data).
HIPPOCAMPUS_DATA_DIR=
