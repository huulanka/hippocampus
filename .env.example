# Copy to .env and fill in. Never commit the real .env file.

# Postgres connection used by the backend.
DATABASE_URL=postgres://hippocampus:hippocampus@localhost:5433/hippocampus

# Address the backend HTTP server binds to.
BIND_ADDR=0.0.0.0:8080

# OpenRouter API key used for structure extraction (entities/relations/tasks).
# Get one at https://openrouter.ai/keys — prefer a provider with a
# zero-data-retention policy given how personal the captured content is.
OPENROUTER_API_KEY=

# Expected "aud" claim of the Cloudflare Access JWT, once the backend is
# deployed behind the Cloudflare Tunnel + Zero Trust Access application.
# Leave empty for local development (JWT verification is skipped).
CF_ACCESS_AUD=
